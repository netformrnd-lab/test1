# aptsq-sync 환경변수 — 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
# ⚠️  .env 와 서비스계정 JSON 은 절대 깃에 올리지 마세요 (.gitignore 에 이미 제외됨)

# ── Firebase (POUR 영업일정, 프로젝트 test-168a4) ──────────────────────────
FIREBASE_DATABASE_URL=https://test-168a4-default-rtdb.asia-southeast1.firebasedatabase.app
# 서비스계정 키. 둘 중 하나:
#   1) JSON 파일 경로:   ./service-account.json
#   2) JSON 통째 문자열:  {"type":"service_account", ...}
# ※ 하이웍스 동기화(sync.js)에서 쓰던 것과 같은 test-168a4 서비스계정을 그대로 쓰면 됩니다.
#   Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# ── Supabase (아파트스퀘어) ────────────────────────────────────────────────
SUPABASE_URL=https://gndktayoicegyqyllybk.supabase.co
# service_role 키 (Supabase → Project Settings → API → service_role). 공개 금지!
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_키
